#!/bin/sh
### BEGIN INIT INFO
# Provides:          metropolis-monitor
# Required-Start:    $remote_fs $network
# Required-Stop:     $remote_fs $network
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: Metropolis cluster monitor
### END INIT INFO

NAME=metropolis-monitor
INSTALL_DIR=/opt/metropolis/monitor
PIDFILE=/run/${NAME}.pid
DEFAULTS=/etc/default/${NAME}
NODE_BIN=/usr/bin/node
RUN_USER=atom
[ ! -r "$DEFAULTS" ] || . "$DEFAULTS"
export NODE_BIN

case "$1" in
  start)
    if [ -s "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
      echo "$NAME already running"
      exit 0
    fi
    echo "Starting $NAME"
    start-stop-daemon --start --background --make-pidfile --pidfile "$PIDFILE" \
      --chuid "$RUN_USER" --chdir "$INSTALL_DIR" --exec "$INSTALL_DIR/monitor-runner.sh"
    ;;
  stop)
    echo "Stopping $NAME"
    start-stop-daemon --stop --retry=TERM/20/KILL/5 --pidfile "$PIDFILE" --remove-pidfile
    ;;
  restart|force-reload)
    "$0" stop
    "$0" start
    ;;
  status)
    if [ -s "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
      echo "$NAME is running (pid $(cat "$PIDFILE"))"
    else
      echo "$NAME is not running"
      exit 1
    fi
    ;;
  *)
    echo "Usage: $0 {start|stop|restart|status}"
    exit 2
    ;;
esac
exit 0
